# Pinned versions for the Wukong development environment.
# Wukong 开发环境的版本锁定。升级时只改这里，并同步修改 wukong.repos。
#
# PX4_VERSION and the px4_msgs branch in wukong.repos must match, otherwise
# PX4 and ROS 2 disagree on message definitions.
# PX4_VERSION 与 wukong.repos 里 px4_msgs 的分支必须对应，否则 PX4 与 ROS 2 的消息定义不一致。

ROS_DISTRO=jazzy
PX4_VERSION=v1.17.0
# PX4 v1.17 still uses the v2 XRCE-DDS client; the v3 agent is NOT compatible.
# PX4 v1.17 仍使用 v2 客户端，v3 版 Agent 不兼容。
XRCE_AGENT_VERSION=v2.4.3

# Third-party sources live outside this public repository.
# 第三方源码放在仓库之外。
WUKONG_DEPS_DIR="${WUKONG_DEPS_DIR:-$HOME/wip/wukong_deps}"
PX4_DIR="${PX4_DIR:-$WUKONG_DEPS_DIR/PX4-Autopilot}"

# Python packages not available from apt, installed with pip --user (scripts/setup/05_python_deps.sh).
# apt 里没有的 Python 包，用 pip --user 安装。
ANTHROPIC_SDK_VERSION=2.12.0
# The SDK's HTTP library (httpx2) uses Brotli >= 1.2 when Brotli is importable;
# Ubuntu's python3-brotli is 1.1.0 and breaks every compressed API response.
# SDK 的 HTTP 库需要 Brotli 1.2 以上；Ubuntu 自带的 1.1.0 会导致响应解压失败。
BROTLI_VERSION=1.2.1
