# Copy this file to .env and fill in real values. .env is never committed.
# 复制本文件为 .env 并填入真实值。.env 不会被提交。

# Claude API key, used by wukong_mission for planning and photo judging.
# Claude API 密钥，wukong_mission 用它做任务规划和照片判断。
# https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# Home position for real flights (never commit real coordinates)
# 真机飞行的起飞点（不要提交真实坐标）
HOME_LAT=
HOME_LON=
HOME_ALT=
