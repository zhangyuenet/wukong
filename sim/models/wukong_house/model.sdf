<?xml version="1.0" encoding="UTF-8"?>
<!--
  A simple house for gutter inspection, built from primitive shapes only.
  一栋只用基本几何体搭成的简单房屋，用来练习检查屋檐水槽。

  Model frame (Gazebo ENU): x east, y north, z up, origin at the centre of the
  footprint on the ground.
    - footprint 10 m (x) by 8 m (y), walls 3 m high
    - gable roof, 30 degree pitch, ridge along x at 5.31 m, 0.5 m eave overhang
    - gutters along the south (y = -4.55) and north (y = +4.55) eaves at ~2.65 m
    - the SOUTH gutter has leaf debris in it, the NORTH gutter is clean
  M2 will make the gutter state configurable. M2 会让水槽状态可配置。
-->
<sdf version="1.9">
  <model name="wukong_house">
    <static>true</static>
    <link name="link">

      <!-- Walls / 墙体 -->
      <collision name="walls_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>10 8 3</size></box></geometry>
      </collision>
      <visual name="walls">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>10 8 3</size></box></geometry>
        <material>
          <ambient>0.85 0.80 0.70 1</ambient>
          <diffuse>0.85 0.80 0.70 1</diffuse>
        </material>
      </visual>

      <!-- Door and windows on the south wall / 南墙上的门窗 -->
      <visual name="door">
        <pose>0 -4.01 1.05 0 0 0</pose>
        <geometry><box><size>1.0 0.02 2.1</size></box></geometry>
        <material>
          <ambient>0.35 0.20 0.10 1</ambient>
          <diffuse>0.35 0.20 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="window_sw">
        <pose>-3 -4.01 1.6 0 0 0</pose>
        <geometry><box><size>1.4 0.02 1.1</size></box></geometry>
        <material>
          <ambient>0.30 0.45 0.60 1</ambient>
          <diffuse>0.30 0.45 0.60 1</diffuse>
        </material>
      </visual>
      <visual name="window_se">
        <pose>3 -4.01 1.6 0 0 0</pose>
        <geometry><box><size>1.4 0.02 1.1</size></box></geometry>
        <material>
          <ambient>0.30 0.45 0.60 1</ambient>
          <diffuse>0.30 0.45 0.60 1</diffuse>
        </material>
      </visual>

      <!-- Gable roof: two slabs, 30 degrees / 双坡屋顶 -->
      <collision name="roof_south_collision">
        <pose>0 -2.25 4.01 0.5236 0 0</pose>
        <geometry><box><size>10.6 5.196 0.15</size></box></geometry>
      </collision>
      <visual name="roof_south">
        <pose>0 -2.25 4.01 0.5236 0 0</pose>
        <geometry><box><size>10.6 5.196 0.15</size></box></geometry>
        <material>
          <ambient>0.45 0.15 0.12 1</ambient>
          <diffuse>0.45 0.15 0.12 1</diffuse>
        </material>
      </visual>
      <collision name="roof_north_collision">
        <pose>0 2.25 4.01 -0.5236 0 0</pose>
        <geometry><box><size>10.6 5.196 0.15</size></box></geometry>
      </collision>
      <visual name="roof_north">
        <pose>0 2.25 4.01 -0.5236 0 0</pose>
        <geometry><box><size>10.6 5.196 0.15</size></box></geometry>
        <material>
          <ambient>0.45 0.15 0.12 1</ambient>
          <diffuse>0.45 0.15 0.12 1</diffuse>
        </material>
      </visual>
      <!-- Gutters: open channel = bottom + outer lip / 水槽：底板加外沿 -->
      <visual name="gutter_south_bottom">
        <pose>0 -4.55 2.60 0 0 0</pose>
        <geometry><box><size>10.6 0.16 0.02</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>
      <visual name="gutter_south_lip">
        <pose>0 -4.63 2.66 0 0 0</pose>
        <geometry><box><size>10.6 0.02 0.14</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>
      <visual name="gutter_north_bottom">
        <pose>0 4.55 2.60 0 0 0</pose>
        <geometry><box><size>10.6 0.16 0.02</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>
      <visual name="gutter_north_lip">
        <pose>0 4.63 2.66 0 0 0</pose>
        <geometry><box><size>10.6 0.02 0.14</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>

      <!-- Leaf debris in the SOUTH gutter, sticking out above the lip -->
      <!-- 南侧水槽里的落叶，高出外沿，从侧面能看到 -->
      <visual name="debris_1">
        <pose>-3.6 -4.55 2.70 0 0 0.3</pose>
        <geometry><box><size>0.9 0.14 0.18</size></box></geometry>
        <material>
          <ambient>0.40 0.30 0.10 1</ambient>
          <diffuse>0.40 0.30 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="debris_2">
        <pose>-2.5 -4.55 2.72 0 0 -0.2</pose>
        <geometry><box><size>0.6 0.14 0.22</size></box></geometry>
        <material>
          <ambient>0.25 0.40 0.12 1</ambient>
          <diffuse>0.25 0.40 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="debris_3">
        <pose>1.8 -4.55 2.71 0 0 0.1</pose>
        <geometry><box><size>1.2 0.14 0.20</size></box></geometry>
        <material>
          <ambient>0.45 0.32 0.12 1</ambient>
          <diffuse>0.45 0.32 0.12 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
